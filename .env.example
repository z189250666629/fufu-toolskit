# Copy this file to .env or set the variables in your shell.
# Do not commit real tokens or cookies.

# fufu-combine (copy apps/fufu-combine/config.example.json to apps/fufu-combine/config.json)
# FUfu-combine itself reads apps/fufu-combine/config.json, not these env vars.

# fufu-act / activity NewAPI admin endpoint
FUFU_API_BASE_URL=https://api.fufuflower.top
FUFU_API_TOKEN=
FUFU_API_USER_ID=1
FUFU_QUOTA_UNIT=500000

# Alternative names also accepted by fufu-act and network-detect
NEWAPI_API_SITE_URL=https://api.fufuflower.top
NEWAPI_API_SITE_TOKEN=
NEWAPI_TOKEN_SITE_URL=https://token.fufuflower.top
NEWAPI_TOKEN_SITE_TOKEN=

# fufu-act / activity MCY shop endpoint
MCY_BASE_URL=
MCY_COOKIE=
MCY_USERNAME=
MCY_PASSWORD=
MCY_LOGIN_ENDPOINT=/admin/login
MCY_UPLOAD_ENDPOINT=/plugin/virtual-card-ship/card/add

# network-detect optional view key
NEWAPI_DASHBOARD_VIEW_KEY=

# Ports
SLOT_PORT=18820
PORT=8080
