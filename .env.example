# Copy this file to .env or set the variables in your shell.
# Do not commit real tokens or cookies.

# fufu-tool-site listens on PORT and serves /, /status, /combine, /activity, /admin.
PORT=8080

# NewAPI admin endpoints shared by status, combine and activity.
NEWAPI_API_SITE_URL=https://api.fufuflower.top
NEWAPI_API_SITE_TOKEN=
NEWAPI_TOKEN_SITE_URL=https://token.fufuflower.top
NEWAPI_TOKEN_SITE_TOKEN=

# Activity module can override the API-site credentials, otherwise use the NewAPI values above.
FUFU_API_BASE_URL=https://api.fufuflower.top
FUFU_API_TOKEN=
FUFU_API_USER_ID=1
FUFU_QUOTA_UNIT=500000
ADMIN_TOKEN=

# Activity / MCY shop endpoint. MCY_COOKIE is optional if username/password login is configured.
MCY_BASE_URL=
MCY_COOKIE=
MCY_USERNAME=
MCY_PASSWORD=
MCY_LOGIN_ENDPOINT=/admin/login
MCY_UPLOAD_ENDPOINT=/plugin/virtual-card-ship/card/add

# Managed-sites JSON is optional; tokenEnv is recommended for secrets.
NEWAPI_MANAGED_API_SITES=
# Optional managed-site JSON override used by deploy-fufu-tool-site and docker compose.
NEWAPI_MANAGED_API_CONFIG=
# CONNECTIVITY_API_URLS 可选：多地址检测覆盖；留空复用非内网 NEWAPI_API_SITE_URL.
CONNECTIVITY_API_URLS=
# CONNECTIVITY_TOKEN_URLS 可选：多地址检测覆盖；留空复用非内网 NEWAPI_TOKEN_SITE_URL.
CONNECTIVITY_TOKEN_URLS=
