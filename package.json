{
  "name": "fufu-toolskit",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for y2k-nav, network-detect (with combine), and fufu-act/activity.",
  "scripts": {
    "deps": "npm run deps:go",
    "deps:go": "go work sync",
    "start:all": "node scripts/start-all.mjs",
    "start:network": "npm --prefix apps/network-detect start",
    "dev:network": "npm --prefix apps/network-detect run dev",
    "build:network": "npm --prefix apps/network-detect run build",
    "test:network": "npm --prefix apps/network-detect test",
    "start:act": "npm --prefix apps/fufu-act start",
    "test:act": "npm --prefix apps/fufu-act test",
    "start:y2k": "npm --prefix apps/y2k-nav start",
    "test:y2k": "npm --prefix apps/y2k-nav test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:workspace": "go test .",
    "test:shared": "go test ./packages/go/fufu/...",
    "test": "npm run test:workspace && npm run test:shared && npm run test:network && npm run test:act && npm run test:y2k && npm run test:scripts"
  },
  "engines": {
    "node": ">=20"
  }
}
